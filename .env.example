# Copy to .env.local and fill in. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=https://oyadyvzvowtfsrdxtdcb.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- e2e tests (npm run test:e2e) ---
# The Playwright tests reuse the keys above and skip themselves when any they need are missing.
# Sign-in tests need Clerk development-instance keys (pk_test_/sk_test_); the RLS test also needs SUPABASE_SECRET_KEY.
# Optional: test an already-running app (local or preview) instead of starting `next dev`.
E2E_BASE_URL=
# Optional: port for the dev server the tests start (default 3100).
E2E_PORT=
# Optional: Clerk test users (created if missing; +clerk_test emails use code 424242). Defaults: hangar-a/hangar-b+clerk_test@example.com
E2E_CLERK_USER_A_EMAIL=
E2E_CLERK_USER_B_EMAIL=
